{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],

    /* This project is JavaScript. `allowJs` lets tsc see the .jsx sources so it has inputs at all,
       and `checkJs` stays off so existing untyped code is not a wall of errors. Any .ts/.tsx a
       change adds IS type-checked. */
    "allowJs": true,
    "checkJs": false,

    /* Vite compiles each file; tsc only ever type-checks here. `--noEmit` is what the OCTIQ
       verify gate runs, and the presence of this file is what makes the gate recognise the
       project at all — without it every stage reports "no recognized build toolchain". */
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["src"]
}
